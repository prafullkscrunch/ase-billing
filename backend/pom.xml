<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.ase</groupId>
  <artifactId>ase-billing</artifactId>
  <version>1.0.0</version>
  <name>ASE Billing and SOA</name>

  <properties>
    <java.version>21</java.version>
    <openpdf.version>2.0.3</openpdf.version>
    <poi.version>5.3.0</poi.version>
    <!-- Overrides Spring Boot 3.3.4's managed 1.18.34, which silently generates
         nothing on JDK 24+. Symptom: hundreds of "cannot find symbol" on getters. -->
    <lombok.version>1.18.38</lombok.version>
    <!--
      Explicit, not just inherited from java.version below — an IDE reading
      this POM needs an unambiguous release target. Without this, IntelliJ
      has been observed defaulting a module's "target bytecode version" to
      something absurdly old (Java 5), which the JDK 21 toolchain then
      refuses to honor outright.
    -->
    <maven.compiler.release>21</maven.compiler.release>
    <frontend.dir>${project.basedir}/../frontend</frontend.dir>
    <!-- -Dskip.frontend=true skips the npm build entirely, for a fast
         backend-only compile when the UI hasn't changed. -->
    <skip.frontend>false</skip.frontend>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway 10+ needs the MySQL module explicitly -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- LGPL/MPL, safe to use commercially. iText 5+ is AGPL; do not swap it in. -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory MySQL-compatible DB for repository tests -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            JDK 23 changed javac's default from -proc:full to -proc:none for
            processors discovered on the classpath. Without this block Lombok is
            never invoked on JDK 23+ and every generated getter reports
            "cannot find symbol". Declaring the processor path explicitly is the
            correct fix and works on every JDK from 17 up.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Builds the React frontend and drops it straight into
        src/main/resources/static, so a plain Maven build (or IntelliJ's Run
        button, with "Delegate IDE build/run actions to Maven" on, or a
        "Before launch: Run Maven Goal" step pointed at generate-resources)
        keeps the served UI in sync with frontend/src automatically — no more
        manually running npm run build and copying dist by hand.

        Uses its OWN private Node/npm under target/, not whatever is (or
        isn't) on the system PATH, so this works the same on every machine.
        Skip with -Dskip.frontend=true for a fast backend-only build when the
        UI hasn't changed.
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.0</version>
        <configuration>
          <workingDirectory>${frontend.dir}</workingDirectory>
          <installDirectory>${project.build.directory}/frontend-tools</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <nodeVersion>v20.17.0</nodeVersion>
              <skip>${skip.frontend}</skip>
            </configuration>
          </execution>
          <execution>
            <id>npm-install</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <!--
                The legacy-peer-deps flag below: a dependency (currently vite)
                can resolve to a newer major release than @vitejs/plugin-react's
                peer range declares support for, purely because of when npm
                happens to run relative to upstream releases — not because of
                anything in this project. The two work together in practice;
                only npm's strict peer-conflict check objects. Without this
                flag, a routine install can start failing on any given day for
                reasons with nothing to do with this codebase.
              -->
              <arguments>install --legacy-peer-deps</arguments>
              <skip>${skip.frontend}</skip>
            </configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build</arguments>
              <skip>${skip.frontend}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Copies the just-built frontend/dist into src/main/resources/static,
        overwriting the previous build. Runs in the same generate-resources
        phase, after the npm-build execution above (plugin executions in one
        phase run in declaration order within the pom) and before Maven's own
        resources:resources copies src/main/resources into target/classes —
        so the compiled app always serves whatever was just built, not last
        session's leftovers.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-frontend-dist</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <skip>${skip.frontend}</skip>
              <outputDirectory>${project.basedir}/src/main/resources/static</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${frontend.dir}/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
